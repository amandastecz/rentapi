meta {
  name: Login with credentials
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/sessions
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

vars:post-response {
  refreshToken: res.body.refresh_token
  token: res.body.token
}

assert {
  res.status: eq 200
}

docs {
  ## POST /sessions
  
  Endpoint de autenticação. Retorna o token JWT e dados do usuário autenticado.
  
  ---
  
  ### Requisição
  **Method:** POST  
  **URL:** `{{baseUrl}}/sessions`  
  **Headers:**  
  `Content-Type: application/json`
  
  **Body:**
  ```json
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
  ```
  
  ---
  
  ### Resposta esperada
  ```json
  {
  {
    "token": "string",
    "user": {
      "name": "string",
      "email": "string"
    },
    "refresh_token": "string"
  }
  ```
}

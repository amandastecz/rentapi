meta {
  name: Login with credentials
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/sessions
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

vars:post-response {
  refreshToken: res.body.refresh_token
  token: res.body.token
}

assert {
  res.status: eq 200
}
